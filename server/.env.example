# Runtime environment: development | test | production
NODE_ENV=development

# HTTP server
HOST=0.0.0.0
PORT=4000

# Comma-separated allowed CORS origins, or * for any
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Data source: 'memory' (default, no database required) or 'postgres'.
# ---------------------------------------------------------------------------
DB_DRIVER=memory

# ---------------------------------------------------------------------------
# PostgreSQL database (only used when DB_DRIVER=postgres)
# Used by src/db/index.ts. When running via docker-compose, the host is `db`.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/job_posting

# Individual parts (optional, if you prefer not to use DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=job_posting

# ---------------------------------------------------------------------------
# Secrets & external API keys — add your own as you wire up features
# ---------------------------------------------------------------------------
# API_KEY=
# JWT_SECRET=
